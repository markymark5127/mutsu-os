# Apps every Mutsu OS install starts with: the Bazzite GNOME default set,
# from Flathub. Flatpak >= 1.16 reads this (flatpak-preinstall(5)):
# - the live USB build installs them into the live system, and the
#   installer copies them to the installed disk;
# - installed systems get anything missing from mutsu-flatpak-preinstall
#   once online. Apps the user removes are not put back.

# Firefox
[Flatpak Preinstall org.mozilla.firefox]
Branch=stable
IsRuntime=false

# Extension Manager
[Flatpak Preinstall com.mattjakeman.ExtensionManager]
Branch=stable
IsRuntime=false

# Protontricks
[Flatpak Preinstall com.github.Matoking.protontricks]
Branch=stable
IsRuntime=false

# DistroShelf
[Flatpak Preinstall com.ranfdev.DistroShelf]
Branch=stable
IsRuntime=false

# Flatseal
[Flatpak Preinstall com.github.tchx84.Flatseal]
Branch=stable
IsRuntime=false

# Warehouse
[Flatpak Preinstall io.github.flattool.Warehouse]
Branch=stable
IsRuntime=false

# Mission Center
[Flatpak Preinstall io.missioncenter.MissionCenter]
Branch=stable
IsRuntime=false

# ProtonPlus
[Flatpak Preinstall com.vysp3r.ProtonPlus]
Branch=stable
IsRuntime=false

