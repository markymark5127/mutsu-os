[Desktop Entry]
Name=Software Updates
Comment=Update Mutsu OS and your apps, or go back to the previous version
Exec=gnome-control-center mutsu-updates
Icon=system-software-update-symbolic
Terminal=false
Type=Application
NoDisplay=true
StartupNotify=true
Categories=GNOME;GTK;Settings;X-GNOME-Settings-Panel;X-GNOME-DetailsSettings;
OnlyShowIn=GNOME;Unity;
Keywords=Update;Upgrade;Software;Version;Rollback;Mutsu;
