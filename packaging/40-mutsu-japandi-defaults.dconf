# Mutsu OS Japandi desktop: real machine-wide GNOME defaults.
# GNOME reads these from the compiled image dconf database at session start.
# Settings are user-overridable; no per-login scripts, resets, or policy locks.
# The Mutsu system database is ordered ahead of Bazzite vendor databases.
#
# GNOME Shell wallpaper / libadwaita light palette.
[org/gnome/desktop/background]
picture-uri='file:///usr/share/backgrounds/mutsu/mutsu-japandi-4k.png'
picture-uri-dark='file:///usr/share/backgrounds/mutsu/mutsu-cyberpunk-4k.png'
picture-options='zoom'

[org/gnome/desktop/screensaver]
picture-uri='file:///usr/share/backgrounds/mutsu/mutsu-japandi-4k.png'
primary-color='#f3efe7'
secondary-color='#516b5c'

[org/gnome/desktop/interface]
color-scheme='prefer-light'
# GNOME/libadwaita supports named accents; green is the nearest
# supported hue to Mutsu sage. Mutsu-owned surfaces use exact #788773.
accent-color='green'
# Missing icons inherit from Adwaita and hicolor.
icon-theme='MutsuJapandi'
sound-theme='MutsuJapandi'
cursor-theme='MutsuJapandi'

# Dash-to-Dock default. Required extension packaged in the Mutsu image.
# Compact, centered, always-visible floating dock instead of the stock
# overview-only dash. No extension list is replaced.
[org/gnome/shell/extensions/dash-to-dock]
dock-position='BOTTOM'
dock-fixed=true
extend-height=false
height-fraction=0.78
dash-max-icon-size=48
show-show-apps-button=true
show-apps-at-top=false
# One dock with GNOME's own look (light, translucent), not a dark custom
# panel: Dash to Dock takes the place of the overview dash, so this is the
# only dock on screen.
custom-background-color=false
transparency-mode='DEFAULT'
apply-custom-theme=false

# Start on the desktop with one desktop, like macOS. More desktops can be
# added from multitasking (+) and stay until removed.
[org/gnome/mutter]
dynamic-workspaces=false

[org/gnome/desktop/wm/preferences]
num-workspaces=1

[org/gnome/shell/extensions/mutsu-adaptive]
enable-experimental-gestures=true

[org/gnome/shell/extensions/touchshell]
top-right-swipe-activation='off'
panel-auto-hide-activation='off'
bottom-edge-swipe-activation='off'
top-center-swipe-activation='off'
flick-to-close-activation='off'
overview-workspace-switch-activation='off'
overview-vertical-swipe-activation='off'
swipe-to-dismiss-notifications-activation='off'
desktop-workspace-switch-activation='off'
desktop-vertical-swipe-activation='off'
auto-maximize-windows-activation='off'
text-selection-activation='off'
text-action-fab-activation='off'
action-bar-activation='off'
window-tiling-flick-activation='off'
