# Mutsu OS Japandi desktop: real machine-wide GNOME defaults.
# GNOME reads these from the compiled image dconf database at session start.
# Settings are user-overridable; no per-login scripts, resets, or policy locks.
# The Mutsu system database is ordered ahead of Bazzite vendor databases.
#
# GNOME Shell wallpaper / libadwaita light palette.
[org/gnome/desktop/background]
picture-uri='file:///usr/share/backgrounds/mutsu/mutsu-japandi-4k.png'
picture-uri-dark='file:///usr/share/backgrounds/mutsu/mutsu-japandi-4k.png'
picture-options='zoom'

[org/gnome/desktop/screensaver]
picture-uri='file:///usr/share/backgrounds/mutsu/mutsu-japandi-4k.png'

[org/gnome/desktop/interface]
color-scheme='prefer-light'
# GNOME/libadwaita supports named accents; green is the nearest
# supported hue to Mutsu sage. Mutsu-owned surfaces use exact #788773.
accent-color='green'
# Missing icons inherit from Adwaita and hicolor.
icon-theme='MutsuJapandi'

# Dash-to-Dock default. Required extension packaged in the Mutsu image.
# Compact, centered, always-visible floating dock instead of the stock
# overview-only dash. No extension list is replaced.
[org/gnome/shell/extensions/dash-to-dock]
dock-position='BOTTOM'
dock-fixed=true
extend-height=false
height-fraction=0.78
dash-max-icon-size=44
show-show-apps-button=true
show-apps-at-top=false
custom-background-color=true
background-color='#2F3330'
background-opacity=0.88
transparency-mode='FIXED'
