[Desktop Entry]
Type=Application
Name=Mutsu Mechanic
GenericName=Mutsu OS assistant
Comment=Ask Mutsu Mechanic for help, search, and approved repairs
Exec=/usr/bin/mutsu-search
Icon=mutsu-ai
Terminal=false
Categories=Utility;System;
Keywords=Mutsu;Mechanic;Search;Spotlight;AI;Repair;
StartupNotify=true
# Started and shown over D-Bus, like GNOME's own apps; one instance,
# kept running between uses (see packaging/mutsu-search).
DBusActivatable=true
