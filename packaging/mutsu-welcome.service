[Unit]
Description=Mutsu OS welcome wizard
Documentation=https://github.com/markymark5127/mutsu-os
After=graphical-session.target
PartOf=graphical-session.target
# No file-existence condition. onboarding.json is written while preferences
# are saved, before setup is finished. The launcher checks is_setup_done().

[Service]
Type=simple
ExecStart=/usr/libexec/mutsu-os/mutsu-first-login
TimeoutStartSec=10min

[Install]
WantedBy=graphical-session.target
