#!/usr/bin/env bash
# Manual Mutsu Portal launcher. Never used from autostart.
set -euo pipefail
export GTK_THEME=MutsuJapandi
config=/usr/share/yafti/yafti.yml
if [[ -x /usr/bin/yafti && -s "$config" ]]; then
  exec /usr/bin/yafti "$config"
fi
echo "Mutsu Portal is not available in this image" >&2
exit 1
