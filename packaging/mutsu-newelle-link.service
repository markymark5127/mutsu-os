[Unit]
Description=Pair Mutsu Search with headless Newelle
Documentation=https://github.com/markymark5127/mutsu-os
After=graphical-session-pre.target
PartOf=graphical-session.target
StartLimitIntervalSec=300
StartLimitBurst=5
# Live USB sessions keep /var in RAM: seeding gigabytes there runs the
# machine out of memory and blocks the login prompt. Skip in live mode
# (Tacklebox live kernels carry tacklebox.live.squashimg=).
ConditionKernelCommandLine=!tacklebox.live.squashimg
# Recheck on login, including users paired by older images without API
# dependencies. Existing dependencies and the user's token are reused.

[Service]
Type=oneshot
ExecStart=/usr/libexec/mutsu-os/setup-newelle-user.sh
TimeoutStartSec=15min
Restart=on-failure
RestartSec=10

[Install]
WantedBy=graphical-session.target
