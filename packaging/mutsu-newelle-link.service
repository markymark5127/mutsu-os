[Unit]
Description=Pair Mutsu Search with headless Newelle
Documentation=https://github.com/markymark5127/mutsu-os
After=graphical-session.target network-online.target
Wants=network-online.target
# Recheck on login, including users paired by older images without API
# dependencies. Existing dependencies and the user's token are reused.

[Service]
Type=oneshot
ExecStart=/usr/libexec/mutsu-os/setup-newelle-user.sh
TimeoutStartSec=10min

[Install]
WantedBy=default.target
