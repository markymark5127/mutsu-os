[Unit]
StartLimitIntervalSec=300
StartLimitBurst=5
Description=Mutsu bundled Qwen 3.5 9B through Ollama
After=local-fs.target
# Not ordered before systemd-user-sessions: login must not wait for the
# multi-gigabyte model seed. Newelle pairing waits for the model itself.
# Live USB sessions keep /var in RAM: seeding gigabytes there runs the
# machine out of memory and blocks the login prompt. Skip in live mode
# (Tacklebox live kernels carry tacklebox.live.squashimg=).
ConditionKernelCommandLine=!tacklebox.live.squashimg

[Service]
Type=simple
DynamicUser=yes
StateDirectory=mutsu-ollama
Environment=HOME=/var/lib/mutsu-ollama
Environment=OLLAMA_HOST=127.0.0.1:11435
Environment=OLLAMA_MODELS=/var/lib/mutsu-ollama/models
Environment=OLLAMA_NO_CLOUD=1
Environment=OLLAMA_CONTEXT_LENGTH=4096
Environment=OLLAMA_NUM_PARALLEL=1
Environment=OLLAMA_MAX_LOADED_MODELS=1
ExecStartPre=+/usr/libexec/mutsu-os/seed-local-model.sh
ExecStart=/usr/libexec/mutsu-os/ollama/bin/ollama serve
TimeoutStartSec=15min
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
