#!/usr/bin/env python3
"""Launch Mutsu's welcome wizard once. Newelle pairing is a separate unit.

The wizard is exec'd so the user unit tracks it. If the user closes the
wizard without finishing, the oneshot ConditionPathExists will re-run it
on the next login until onboarding.json exists.
"""
from __future__ import annotations
import os
import sys

sys.path.insert(0, "/usr/libexec/mutsu-os/src")
from aidesktop.onboarding import is_setup_done

if is_setup_done():
    raise SystemExit(0)

os.execv("/usr/bin/mutsu-search", ["/usr/bin/mutsu-search", "--setup"])
