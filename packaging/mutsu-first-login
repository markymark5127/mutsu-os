"""Launch Mutsu's welcome wizard only until this user finishes or skips it."""
from __future__ import annotations
import subprocess
import sys

sys.path.insert(0, "/usr/libexec/mutsu-os/src")
from aidesktop.onboarding import is_setup_done

if not is_setup_done():
    subprocess.Popen(["/usr/bin/mutsu-search", "--setup"], close_fds=True)
