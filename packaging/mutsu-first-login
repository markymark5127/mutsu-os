#!/usr/bin/env python3
"""Launch Mutsu's welcome wizard until setup is completed or skipped.

The wizard is exec'd so the user unit tracks it. Completion is the saved
status, not the presence of onboarding.json. Preference saves create that
file before the user finishes.
"""
from __future__ import annotations
import os
import sys

sys.path.insert(0, "/usr/libexec/mutsu-os/src")
from aidesktop.onboarding import is_setup_done

if is_setup_done():
    raise SystemExit(0)

os.execv("/usr/bin/mutsu-search", ["/usr/bin/mutsu-search", "--setup"])
