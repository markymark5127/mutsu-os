# Applies only as a default for users without an existing wallpaper choice.
# This is not a lock and does not override existing user preferences.
[org.gnome.desktop.background]
picture-uri='file:///usr/share/backgrounds/mutsu/mutsu-japandi-4k.png'
picture-uri-dark='file:///usr/share/backgrounds/mutsu/mutsu-japandi-4k.png'

# New-user Japandi lock-screen defaults, not forced per-login changes.
[org.gnome.desktop.screensaver]
picture-uri='file:///usr/share/backgrounds/mutsu/mutsu-japandi-4k.png'
primary-color='#f3efe7'
secondary-color='#516b5c'
