#!/usr/bin/env python3
"""Activate Mutsu's reversible GNOME branding once for a new user.

Do not replace GNOME's entire enabled-extensions list, overwrite a user-picked
wallpaper, or record success on a failed activation. Failed first login is
retried on a future login; a working desktop is preferable to forced branding.
"""
from __future__ import annotations

import os
from pathlib import Path
import subprocess
import sys

MARKER = Path.home() / ".config" / "mutsu-os" / "first-boot-done"
BRANDING = "mutsu-branding@mutsu-os"
SCHEMA = "org.gnome.shell.extensions.mutsu-branding"
EXTENSION_SCHEMAS = f"/usr/share/gnome-shell/extensions/{BRANDING}/schemas"


def run(*cmd: str, env: dict[str, str] | None = None) -> subprocess.CompletedProcess[str]:
    return subprocess.run(cmd, text=True, capture_output=True, check=False, env=env)


def activate() -> None:
    result = run("gnome-extensions", "enable", BRANDING)
    if result.returncode != 0:
        raise RuntimeError(
            "GNOME rejected Mutsu branding (version or session not ready): "
            + (result.stderr.strip() or result.stdout.strip())
        )
    # GNOME extensions ship schema overrides within their own schemas dir;
    # plain gsettings does not see those schemas in the global search path.
    env = os.environ.copy()
    env["GSETTINGS_SCHEMA_DIR"] = EXTENSION_SCHEMAS
    pref = run("gsettings", "set", SCHEMA, "appearance", "japandi", env=env)
    if pref.returncode != 0:
        raise RuntimeError("Could not set Mutsu Japandi theme: " + pref.stderr.strip())

    # Defaults already set the Japandi wallpaper via the image's GSettings
    # override. Never clobber an intentional wallpaper change on login.


def main() -> int:
    if MARKER.exists():
        return 0
    try:
        activate()
    except (OSError, RuntimeError) as exc:
        print(f"Mutsu first-boot branding not applied; will retry: {exc}", file=sys.stderr)
        return 1
    MARKER.parent.mkdir(parents=True, exist_ok=True)
    MARKER.write_text("done\n", encoding="utf-8")
    os.chmod(MARKER, 0o600)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
