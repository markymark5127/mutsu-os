#!/usr/bin/env python3
"""Apply first-user Mutsu branding, Adaptive Desktop, and optional dock.

Extension activation is additive. Failures never get marked as complete.
"""
from __future__ import annotations

import os
from pathlib import Path
import subprocess
import sys

MARKER = Path.home() / ".config" / "mutsu-os" / "first-boot-done"
BRANDING = "mutsu-branding@mutsu-os"
ADAPTIVE = "mutsu-adaptive@mutsu-os"
DOCK = "dash-to-dock@micxgx.gmail.com"
BRANDING_SCHEMA = "org.gnome.shell.extensions.mutsu-branding"
ADAPTIVE_SCHEMA = "org.gnome.shell.extensions.mutsu-adaptive"
DOCK_SCHEMA = "org.gnome.shell.extensions.dash-to-dock"


def run(*cmd: str, env: dict[str, str] | None = None) -> subprocess.CompletedProcess[str]:
    return subprocess.run(cmd, text=True, capture_output=True, check=False, env=env)


def settings_env(uuid: str) -> dict[str, str]:
    env = os.environ.copy()
    for base in (
        Path.home() / ".local/share/gnome-shell/extensions",
        Path("/usr/share/gnome-shell/extensions"),
    ):
        schema_dir = base / uuid / "schemas"
        if (schema_dir / "gschemas.compiled").is_file():
            env["GSETTINGS_SCHEMA_DIR"] = str(schema_dir)
            break
    return env


def activate_branding() -> None:
    result = run("gnome-extensions", "enable", BRANDING)
    if result.returncode != 0:
        raise RuntimeError(
            "Mutsu branding extension couldn't be enabled: "
            + (result.stderr.strip() or result.stdout.strip())
        )
    result = run(
        "gsettings", "set", BRANDING_SCHEMA, "appearance", "japandi",
        env=settings_env(BRANDING),
    )
    if result.returncode != 0:
        raise RuntimeError("Could not select Japandi branding: " + result.stderr.strip())


def configure_adaptive() -> None:
    probe = run("gnome-extensions", "info", ADAPTIVE)
    if probe.returncode != 0:
        print("Mutsu Adaptive Desktop not installed", file=sys.stderr)
        return
    enabled = run("gnome-extensions", "enable", ADAPTIVE)
    if enabled.returncode != 0:
        print("Mutsu Adaptive Desktop could not be enabled", file=sys.stderr)
        return
    env = settings_env(ADAPTIVE)
    settings = {
        "mode": "automatic",
        "enable-experimental-gestures": "true",
        "open-home-on-tablet": "true",
        "collapse-dock-in-tablet": "true",
    }
    for key, value in settings.items():
        changed = run("gsettings", "set", ADAPTIVE_SCHEMA, key, value, env=env)
        if changed.returncode != 0:
            print(f"Mutsu Adaptive setting unavailable: {key}", file=sys.stderr)


def configure_optional_dock() -> None:
    probe = run("gnome-extensions", "info", DOCK)
    if probe.returncode != 0:
        return
    enabled = run("gnome-extensions", "enable", DOCK)
    if enabled.returncode != 0:
        print("Mutsu dock unavailable; normal GNOME remains usable", file=sys.stderr)
        return
    env = settings_env(DOCK)
    settings = {
        "dock-position": "BOTTOM",
        "dock-fixed": "true",
        "show-apps-at-top": "false",
        "show-show-apps-button": "true",
    }
    for key, value in settings.items():
        changed = run("gsettings", "set", DOCK_SCHEMA, key, value, env=env)
        if changed.returncode != 0:
            print(f"Mutsu dock setting unavailable: {key}", file=sys.stderr)


def main() -> int:
    if MARKER.exists():
        return 0
    try:
        activate_branding()
    except (OSError, RuntimeError) as exc:
        print(f"Mutsu first boot not finished; will retry on next login: {exc}", file=sys.stderr)
        return 1
    configure_adaptive()
    configure_optional_dock()
    MARKER.parent.mkdir(parents=True, exist_ok=True)
    MARKER.write_text("done\n", encoding="utf-8")
    os.chmod(MARKER, 0o600)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
