{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/mutsu-os/terminal/logo.txt",
    "color": {"1": "green"}
  },
  "display": {
    "separator": "  │  ",
    "color": {"keys": "green"}
  },
  "modules": [
    {"type": "title"},
    "break",
    {"type": "os", "key": "OS", "format": "{pretty-name}"},
    {"type": "kernel", "key": "Kernel"},
    {"type": "uptime", "key": "Uptime"},
    "break",
    {"type": "host", "key": "Computer"},
    {"type": "cpu", "key": "CPU"},
    {"type": "gpu", "key": "GPU"},
    {"type": "memory", "key": "Memory"},
    {"type": "disk", "key": "Disk"},
    "break",
    {"type": "de", "key": "Desktop"},
    {"type": "shell", "key": "Shell"},
    {"type": "terminal", "key": "Terminal"},
    "break",
    "colors"
  ]
}
