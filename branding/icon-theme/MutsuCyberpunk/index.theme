[Icon Theme]
Name=Mutsu Cyberpunk
Comment=Mutsu's neon cyberpunk desktop icon theme; fall back to GNOME icons
Inherits=Adwaita,hicolor
Directories=scalable/apps,scalable/actions,scalable/places


[scalable/apps]
Size=64
MinSize=16
MaxSize=512
Type=Scalable
Context=Applications

[scalable/actions]
Size=24
MinSize=16
MaxSize=128
Type=Scalable
Context=Actions

[scalable/places]
Size=64
MinSize=16
MaxSize=512
Type=Scalable
Context=Places
