[Icon Theme]
Name=Mutsu Japandi
Comment=Mutsu's calm sage/cream desktop icon theme; fall back to GNOME icons
Inherits=Adwaita,hicolor
Directories=scalable/apps,scalable/actions

[scalable/apps]
Size=64
MinSize=16
MaxSize=512
Type=Scalable
Context=Applications

[scalable/actions]
Size=24
MinSize=16
MaxSize=128
Type=Scalable
Context=Actions
