# Mutsu OS — centered approved two-wave emblem and accessible text prompts.
# Script splash requires the plymouth-plugin-script RPM in the image.
Window.SetBackgroundTopColor(0.953, 0.941, 0.910);
Window.SetBackgroundBottomColor(0.953, 0.941, 0.910);

logo_image = Image("mutsu-boot-logo.png");
logo_sprite = Sprite(logo_image);
logo_sprite.SetZ(10);

# Spinner: small emblem under the main logo, not the full-screen mark.
spinner_source = Image("mutsu-boot-logo.png");
spinner_size = 56;
spinner_image = spinner_source.Scale(spinner_size, spinner_size);
spinner_sprite = Sprite(spinner_image);
spinner_sprite.SetZ(5);
spinner_index = 0;
spinner_frames = 24;
spinner_cache = [];
for (i = 0; i < spinner_frames; i++) {
    spinner_cache[i] = spinner_image.Rotate(2 * Math.Pi * i / spinner_frames);
}
spinner_sprite.SetOpacity(0.55);

# Status text under the logo, named for what the machine is doing. Plymouth
# runs this same theme at power-on, shutdown, restart and while offline
# updates install, so a single "Preparing" label was wrong most of the time.
fun status_label() {
    mode = Plymouth.GetMode();
    if (mode == "shutdown") return "Shutting down";
    if (mode == "reboot") return "Restarting";
    if (mode == "updates" || mode == "system-upgrade") return "Installing updates. Keep your computer on";
    if (mode == "firmware-upgrade") return "Updating firmware. Keep your computer on";
    return "Starting Mutsu OS";
}
status_text = status_label();
# Offline updates report their progress; show it after the label.
update_percent = -1;
status_image = Image.Text(status_text, 0.14, 0.17, 0.14);
status_sprite = Sprite(status_image);
status_sprite.SetZ(15);

# Explicit password and question callbacks matter for encrypted disks.
# Never print the actual password; only show bullet counts.
input_image = Image.Text(" ", 0.14, 0.17, 0.14);
input_sprite = Sprite(input_image);
input_sprite.SetZ(20);
input_sprite.SetOpacity(0);

fun center_sprites() {
    logo_sprite.SetX((Window.GetWidth() - logo_image.GetWidth()) / 2);
    logo_sprite.SetY((Window.GetHeight() - logo_image.GetHeight()) / 2);
    spinner_sprite.SetX((Window.GetWidth() - spinner_image.GetWidth()) / 2);
    spinner_sprite.SetY(logo_sprite.GetY() + logo_image.GetHeight() + 28);
    status_sprite.SetX((Window.GetWidth() - status_image.GetWidth()) / 2);
    status_sprite.SetY(Window.GetHeight() * 0.72);
    input_sprite.SetX((Window.GetWidth() - input_image.GetWidth()) / 2);
    input_sprite.SetY(Window.GetHeight() * 0.80);
}

fun display_password(prompt, bullet_count) {
    masked = "";
    for (i = 0; i < bullet_count; i++) masked = masked + "*";
    input_image = Image.Text("Enter passphrase: " + masked, 0.14, 0.17, 0.14);
    input_sprite.SetImage(input_image);
    input_sprite.SetOpacity(1);
    center_sprites();
}

fun display_question(prompt, entry) {
    input_image = Image.Text(prompt + "  " + entry, 0.14, 0.17, 0.14);
    input_sprite.SetImage(input_image);
    input_sprite.SetOpacity(1);
    center_sprites();
}

fun display_normal() {
    input_sprite.SetOpacity(0);
}

fun refresh() {
    spinner_index = (spinner_index + 1) % spinner_frames;
    spinner_sprite.SetImage(spinner_cache[spinner_index]);
    dots = ".";
    t = Math.Int(Plymouth.GetTime() * 2) % 3;
    if (t == 1) dots = "..";
    if (t == 2) dots = "...";
    label = status_text + dots;
    if (update_percent >= 0) label = status_text + "  " + update_percent + "%";
    status_image = Image.Text(label, 0.14, 0.17, 0.14);
    status_sprite.SetImage(status_image);
    center_sprites();
}

Plymouth.SetRefreshFunction(refresh);
Plymouth.SetDisplayPasswordFunction(display_password);
Plymouth.SetDisplayQuestionFunction(display_question);
Plymouth.SetDisplayNormalFunction(display_normal);

fun system_update(progress) {
    update_percent = Math.Int(progress);
}
Plymouth.SetSystemUpdateFunction(system_update);
