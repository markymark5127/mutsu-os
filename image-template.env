# Here we set a bunch of parameters for your image build

# output image name, usually same as repo name, change as needed
IMAGE_NAME=mutsu-os

# Make this the same as your github username/organisation
REPO_ORGANIZATION="markymark5127"

IMAGE_DESC="Mutsu OS: a Mac-familiar GNOME gaming desktop based on Bazzite"
IMAGE_KEYWORDS="mutsu,gnome,bazzite,bootc,gaming,linux"

# Put your own image here for a fancy profile on https://artifacthub.io/!
IMAGE_LOGO_URL="https://raw.githubusercontent.com/markymark5127/mutsu-os/main/branding/icons/mutsu-logo-symbol.svg"
DEFAULT_TAG="latest"
BIB_IMAGE="quay.io/centos-bootc/bootc-image-builder:latest"
